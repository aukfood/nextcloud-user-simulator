   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * avg by (vm) (rate(node_cpu_seconds_total{mode=\"steal\",vm=~\"$vm\"}[1m]))",
     "legendFormat": "steal {{vm}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     },
     "expr": "100 * avg by (vm) (rate(node_cpu_seconds_total{mode=\"iowait\",vm=~\"$vm\"}[1m]))",
     "legendFormat": "iowait {{vm}}",
     "refId": "B"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Réseau reçu (bit/s)",
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
